# skill-loop 环境变量模板
#
# 用法：把本文件复制成 .env（同目录）后填入真实值。.env 已被 .gitignore 忽略。
#
# run_live.py 和 run_v2_parallel.ps1（真模型联调）会读这些变量；跑单测与 build 不需要。
# 加载顺序：先找 skill-loop/.env，找不到再找仓库根的 .env。

# --- LLM（OpenAI 兼容接口） ---
# run_live.py 会把这里的 TRAVEL_* 映射成各模块需要的 LLM_* 变量。
TRAVEL_LLM_BASE_URL=https://your-endpoint/v1
TRAVEL_LLM_API_KEY=
TRAVEL_CLASSIFIER_MODEL=your-fast-model
TRAVEL_GENERATOR_MODEL=your-strong-model
# 推理模型会把 reasoning 计入输出预算；v2 大模型评测建议 12288 / 180。
TRAVEL_LLM_MAX_TOKENS=12288
TRAVEL_LLM_TIMEOUT_SECONDS=180
