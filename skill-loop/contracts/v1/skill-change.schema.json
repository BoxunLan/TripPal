{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tour-skill-system.local/contracts/v1/skill-change.schema.json",
  "title": "skill-change v1",
  "type": "object",
  "required": [
    "schema_version",
    "change_id",
    "operation",
    "target_section",
    "evidence_tasks",
    "failure_pattern",
    "proposed_change",
    "expected_effect",
    "regression_risk",
    "acceptance_test"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["add", "revise", "merge", "delete"] },
    "target_section": { "type": "string", "minLength": 1 },
    "evidence_tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "failure_pattern": { "type": "string", "minLength": 1, "maxLength": 80 },
    "proposed_change": { "type": "string", "minLength": 1 },
    "expected_effect": { "type": "string", "minLength": 1 },
    "regression_risk": { "type": "string", "minLength": 1 },
    "acceptance_test": { "type": "string", "minLength": 1 }
  }
}
