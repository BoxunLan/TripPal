{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tour-skill-system.local/contracts/v1/scenario.schema.json",
  "title": "scenario v1",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "pool",
    "query_cluster",
    "evidence_record_ids",
    "geo",
    "language",
    "time_window"
  ],
  "properties": {
    "schema_version": { "const": "v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "pool": { "enum": ["high_frequency", "rising"] },
    "query_cluster": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "geo": { "type": "string", "minLength": 2 },
    "language": { "type": "string", "minLength": 2 },
    "time_window": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    }
  }
}
