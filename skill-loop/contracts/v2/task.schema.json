{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippal.local/skill-loop/contracts/v2/task.schema.json",
  "title": "task v2",
  "description": "在 v1 之上新增 artifact_card 任务类型与卡点维度，并新增 not_contains / any_of 两个断言算子。已启用（dataset v2，见 docs/dataset-v2.md）。",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "scenario_id",
    "split",
    "task_type",
    "demand_evidence",
    "prompt",
    "initial_state",
    "allowed_tools",
    "expected_end_state",
    "verifier",
    "prohibited_leakage"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "task_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "split": { "enum": ["train", "holdout"] },
    "task_type": { "enum": ["fact_lookup", "conditional_decision", "artifact_card"] },
    "demand_evidence": {
      "type": "object",
      "required": ["source", "query_cluster", "geo", "time_window"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "query_cluster": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "geo": { "type": "string", "minLength": 2 },
        "time_window": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "prompt": { "type": "string", "minLength": 1 },
    "initial_state": { "type": "object" },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "expected_end_state": { "type": "object" },
    "verifier": {
      "type": "object",
      "required": ["kind", "assertions"],
      "properties": {
        "kind": { "enum": ["deterministic"] },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["op", "value"],
            "properties": {
              "op": { "enum": ["contains", "regex", "json_path_equals", "not_contains", "any_of"] },
              "value": {},
              "path": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "prohibited_leakage": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact": {
      "description": "task_type=artifact_card 时声明要产出的东西及其卡点维度。",
      "type": "object",
      "required": ["dimensions"],
      "properties": {
        "dimensions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["information", "tooling", "language", "payment", "identity_verification"]
          }
        },
        "format": { "enum": ["checklist", "step_plan", "template"] }
      }
    }
  }
}
