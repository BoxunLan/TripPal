{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trippal.local/skill-loop/contracts/v2/scenario.schema.json",
  "title": "scenario v2",
  "description": "在 v1 之上新增策展来源字段（触发时点/成功判据/卡点编号）与垂直标识。本期不启用，见 contracts/v2/README.md。",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "title",
    "pool",
    "query_cluster",
    "evidence_record_ids",
    "geo",
    "language",
    "time_window"
  ],
  "properties": {
    "schema_version": { "const": "v2" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "pool": { "enum": ["high_frequency", "rising"] },
    "query_cluster": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "geo": { "type": "string", "minLength": 2 },
    "language": { "type": "string", "minLength": 2 },
    "time_window": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "origin": { "enum": ["clustered", "imported"] },
    "vertical": { "type": "string", "minLength": 1 },
    "trigger_timing": { "type": "string" },
    "success_criteria": { "type": "string" },
    "pain_point_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
