{
  "openapi": "3.1.0",
  "info": {
    "title": "旅行 Agent — 两周垂直切片",
    "description": "clarify → (realtime 旁路 | knowledge 旁路 | classify → route → retrieve → generate → validate) → output",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/plan": {
      "post": {
        "summary": "Plan",
        "operationId": "plan_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/ClarifyResponse"
                    },
                    {
                      "$ref": "#/components/schemas/PlanResponse"
                    },
                    {
                      "$ref": "#/components/schemas/RealtimeResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AnswerResponse"
                    },
                    {
                      "$ref": "#/components/schemas/GuideResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DegradedResponse"
                    }
                  ],
                  "title": "Response Plan Plan Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
