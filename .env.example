# 复制为 .env 后填写。.env 已在 .gitignore 中，不要提交。

# --- LLM：分类（小模型，结构化输出）---
TRAVEL_CLASSIFIER_MODEL=
TRAVEL_CLASSIFIER_API_KEY=
# --- LLM：行程生成（强推理模型）---
TRAVEL_GENERATOR_MODEL=
TRAVEL_GENERATOR_API_KEY=
# 两者缺省时回落到 TRAVEL_LLM_API_KEY，方便只配一把 Key
TRAVEL_LLM_API_KEY=
TRAVEL_LLM_BASE_URL=https://api.openai.com/v1

# --- Embedding ---
# 留空 = 使用本地确定性 hash embedding（无外部依赖，召回质量仅供跑通链路）
TRAVEL_EMBEDDING_MODEL=
# 必须与 docker/init/01_schema.sql 的 vector(N) 一致（两条 embedding 路径共用 1024 维）
TRAVEL_EMBEDDING_DIM=1024
# 缺省回落到 TRAVEL_LLM_API_KEY / TRAVEL_LLM_BASE_URL
TRAVEL_EMBEDDING_API_KEY=
TRAVEL_EMBEDDING_BASE_URL=
# 单次请求的 input 条数上限。端点普遍有批量限制（实测 ecnu-embedding-small：32 条通过、64 条 500）
TRAVEL_EMBEDDING_BATCH=16

# --- 向量库（PostgreSQL + pgvector）---
DATABASE_URL=postgresql://travel:travel@localhost:5433/travel

# --- 运行时 ---
# fake = 完全离线（假 LLM + 内存向量库），无需任何密钥；openai = 打真实接口
TRAVEL_LLM_PROVIDER=openai
TRAVEL_VECTOR_BACKEND=pg
